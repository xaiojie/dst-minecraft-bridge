+#include "camera_http.h"
+#import <Cocoa/Cocoa.h>
+#include <CommonCrypto/CommonDigest.h>
+#include <algorithm>
+#include <chrono>
+#include <fcntl.h>
+#include <fstream>
+#include <netinet/in.h>
+#include <sstream>
+#include <sys/mman.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <thread>
+#include <unistd.h>
+namespace bridge {
+namespace {
+struct State {
+  dstmc::CameraService service;
+  std::mutex key_mutex, window_mutex;
+  dstmc::FrameKey current_key{};
+  NSDictionary *window_info = nil;
+  uint64_t last_composite = 0;
+  bool enabled = false;
+  std::string directory;
+};
+State &state() {
+  static auto *value = new State;
+  return *value;
+}
+uint64_t milliseconds() {
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+} // namespace
+dstmc::CameraService &camera_service() { return state().service; }
+bool enabled() { return state().enabled; }
+dstmc::FrameKey key() {
+  std::lock_guard<std::mutex> lock(state().key_mutex);
+  return state().current_key;
+}
+void log(NSDictionary *record) {
+  NSData *data = [NSJSONSerialization dataWithJSONObject:record
+                                                 options:0
+                                                   error:nil];
+  if (data) {
+    std::ofstream out(state().directory + "/camera-gate.jsonl", std::ios::app);
+    out.write((const char *)data.bytes, data.length);
+    out << '\n';
+  }
+}
+NSString *string(id object) {
+  if (![object isKindOfClass:[NSString class]])
+    throw std::runtime_error("expected string");
+  return object;
+}
+NSDictionary *object(id value) {
+  if (![value isKindOfClass:[NSDictionary class]])
+    throw std::runtime_error("expected object");
+  return value;
+}
+void fields(NSDictionary *o, NSArray *keys) {
+  object(o);
+  if (![[NSSet setWithArray:o.allKeys] isEqual:[NSSet setWithArray:keys]])
+    throw std::runtime_error("unexpected fields");
+}
+std::array<uint8_t, 16> uuid(id value) {
+  NSUUID *u = [[NSUUID alloc] initWithUUIDString:string(value)];
+  if (!u)
+    throw std::runtime_error("invalid UUID");
+  std::array<uint8_t, 16> b{};
+  [u getUUIDBytes:b.data()];
+  [u release];
+  return b;
+}
+NSString *quote(NSString *s) {
+  NSData *d = [NSJSONSerialization
+      dataWithJSONObject:@[ s ]
+                 options:(NSJSONWritingFragmentsAllowed |
+                          NSJSONWritingWithoutEscapingSlashes)
+                   error:nil];
+  NSString *t = [[[NSString alloc] initWithData:d encoding:NSUTF8StringEncoding]
+      autorelease];
+  return [t substringWithRange:NSMakeRange(1, t.length - 2)];
+}
+dstmc::FrameKey parse_key(NSDictionary *key) {
+  fields(key, @[ @"pair", @"epoch", @"id" ]);
+  NSDictionary *p = object(key[@"pair"]);
+  fields(
+      p,
+      @[ @"dst_world", @"dst_shard", @"mc_world", @"mc_dimension", @"region" ]);
+  uuid(p[@"dst_world"]);
+  uuid(p[@"mc_world"]);
+  NSMutableString *canonical = [NSMutableString stringWithString:@"{"];
+  bool first = true;
+  for (NSString *k in @[
+         @"dst_world", @"dst_shard", @"mc_world", @"mc_dimension", @"region"
+       ]) {
+    NSString *v = string(p[k]);
+    if ([k isEqual:@"dst_world"] || [k isEqual:@"mc_world"])
+      v = v.lowercaseString;
+    if (!v.length)
+      throw std::runtime_error("empty pair field");
+    if (!first)
+      [canonical appendString:@","];
+    first = false;
+    [canonical appendFormat:@"%@:%@", quote(k), quote(v)];
+  }
+  [canonical appendString:@"}"];
+  dstmc::FrameKey out{};
+  NSData *d = [canonical dataUsingEncoding:NSUTF8StringEncoding];
+  CC_SHA256(d.bytes, (CC_LONG)d.length, out.pair_hash.data());
+  out.epoch = uuid(key[@"epoch"]);
+  id n = key[@"id"];
+  if (![n isKindOfClass:[NSNumber class]] || [n doubleValue] < 0 ||
+      [n doubleValue] > 9007199254740991. ||
+      [n doubleValue] != std::floor([n doubleValue]))
+    throw std::runtime_error("invalid frame ID");
+  out.id = [n unsignedLongLongValue];
+  return out;
+}
+NSDictionary *get_status() {
+  NSURLRequest *r = [NSURLRequest
+       requestWithURL:[NSURL URLWithString:@"http://127.0.0.1:39379/v2/status"]
+          cachePolicy:NSURLRequestReloadIgnoringLocalCacheData
+      timeoutInterval:.15];
+  NSURLResponse *response = nil;
+  NSData *d = [NSURLConnection sendSynchronousRequest:r
+                                    returningResponse:&response
+                                                error:nil];
+  if (!d || d.length > 65536 ||
+      [(NSHTTPURLResponse *)response statusCode] != 200)
+    throw std::runtime_error("MC status unavailable");
+  return object([NSJSONSerialization JSONObjectWithData:d options:0 error:nil]);
+}
+struct Mapping {
+  void *base = MAP_FAILED;
+  size_t length = 0;
+  ~Mapping() {
+    if (base != MAP_FAILED)
+      munmap(base, length);
+  }
+};
+void discover(dstmc::FrameKey expected) {
+  NSDictionary *s = get_status();
+  if (![s[@"protocol"] isEqual:@2] || ![s[@"status"] isEqual:@"PAIRED"])
+    throw std::runtime_error("MC not paired");
+  // Refresh physical size even while an exact frame is pinned. A new mapping
+  // announced after resize must invalidate the old camera acknowledgment.
+  state().service.resize([s[@"width"] unsignedIntValue],
+                         [s[@"height"] unsignedIntValue]);
+  auto latest = parse_key(object(s[@"latest_frame"]));
+  if (!dstmc::same_key(latest, expected))
+    throw std::runtime_error("exact frame changed; retry");
+  if (![s[@"pair"] isEqual:object(s[@"latest_frame"])[@"pair"]] ||
+      ![s[@"epoch"] isEqual:object(s[@"latest_frame"])[@"epoch"]])
+    throw std::runtime_error("status session mismatch");
+  if (state().service.lease_latest(expected.pair_hash, expected.epoch))
+    return; // Keep the existing slot; never attempt a second reader lease.
+  NSString *path = string(s[@"frame_path"]);
+  int fd = open(path.fileSystemRepresentation, O_RDWR | O_NOFOLLOW);
+  if (fd < 0)
+    throw std::runtime_error("frame open failed");
+  struct stat st{};
+  if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_uid != getuid() ||
+      st.st_size < 4096 || st.st_size > 80 * 1024 * 1024) {
+    close(fd);
+    throw std::runtime_error("invalid mapping");
+  }
+  auto mapping = std::make_shared<Mapping>();
+  mapping->length = st.st_size;
+  mapping->base =
+      mmap(nullptr, mapping->length, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+  close(fd);
+  if (mapping->base == MAP_FAILED)
+    throw std::runtime_error("mapping failed");
+  auto frame = dstmc::read_frame(mapping->base, mapping->length, expected);
+  if (!frame)
+    throw std::runtime_error("exact complete frame unavailable");
+  if (frame->width != [s[@"width"] unsignedIntValue] ||
+      frame->height != [s[@"height"] unsignedIntValue])
+    throw std::runtime_error("stream resize");
+  state().service.offer(std::make_shared<dstmc::FrameView>(std::move(*frame)),
+                        mapping);
+}
+NSArray *matrix(const std::array<float, 16> &m) {
+  NSMutableArray *a = [NSMutableArray arrayWithCapacity:16];
+  for (float x : m)
+    [a addObject:@(x)];
+  return a;
+}
+NSDictionary *vec(dstmc::Vec3 v) {
+  return @{@"x" : @(v.x), @"y" : @(v.y), @"z" : @(v.z)};
+}
+NSDictionary *handle(NSString *path, NSString *method, NSDictionary *body) {
+  if ([path isEqual:@"/v2/window"] && [method isEqual:@"GET"]) {
+    std::lock_guard<std::mutex> lock(state().window_mutex);
+    if (!state().window_info || milliseconds() - state().last_composite >= 250)
+      throw std::runtime_error("no recently composited frame");
+    return [[state().window_info retain] autorelease];
+  }
+  if (![method isEqual:@"POST"])
+    throw std::runtime_error("method not supported");
+  bool lease = [path isEqual:@"/v2/camera/lease"],
+       applied = [path isEqual:@"/v2/camera/applied"];
+  if (!lease && !applied)
+    throw std::runtime_error("unknown endpoint");
+  fields(body, lease ? @[ @"protocol", @"pair", @"epoch", @"key" ]
+                     : @[ @"protocol", @"pair", @"epoch", @"key", @"applied" ]);
+  if (![body[@"protocol"] isEqual:@2])
+    throw std::runtime_error("protocol mismatch");
+  NSDictionary *key = object(body[@"key"]);
+  if (![body[@"pair"] isEqual:key[@"pair"]] ||
+      ![body[@"epoch"] isEqual:key[@"epoch"]])
+    throw std::runtime_error("request session mismatch");
+  auto k = parse_key(key);
+  if (applied) {
+    if (CFGetTypeID((CFTypeRef)body[@"applied"]) != CFBooleanGetTypeID())
+      throw std::runtime_error("applied must be boolean");
+    bool accepted = false;
+    if ([body[@"applied"] boolValue])
+      accepted = state().service.camera_applied(k);
+    else {
+      std::lock_guard<std::mutex> lock(state().key_mutex);
+      if (dstmc::same_key(k, state().current_key))
+        state().service.release();
+    }
+    return @{
+      @"protocol" : @2,
+      @"pair" : body[@"pair"],
+      @"epoch" : body[@"epoch"],
+      @"key" : key,
+      @"accepted" : @(accepted)
+    };
+  }
+  // Repeated requests return the pinned pose, never a different image under the
+  // requested key.
+  discover(k);
+  auto l = state().service.lease_latest(k.pair_hash, k.epoch);
+  if (!l || !dstmc::same_key(l->key, k))
+    throw std::runtime_error("different frame pinned or stale");
+  {
+    std::lock_guard<std::mutex> lock(state().key_mutex);
+    state().current_key = k;
+  }
+  NSDictionary *pose = @{
+    @"space" : @"DST",
+    @"position" : vec(l->pose.position),
+    @"forward" : vec(l->pose.forward),
+    @"up" : vec(l->pose.up),
+    @"view" : matrix(l->pose.view),
+    @"projection" : matrix(l->pose.projection)
+  };
+  return @{
+    @"protocol" : @2,
+    @"pair" : body[@"pair"],
+    @"epoch" : body[@"epoch"],
+    @"lease" : @{
+      @"key" : key,
+      @"pose" : pose,
+      @"width" : @(l->width),
+      @"height" : @(l->height)
+    }
+  };
+}
+void serve(int server) {
+  for (;;) {
+    int client = accept(server, nullptr, nullptr);
+    if (client < 0)
+      break;
+    @autoreleasepool {
+      timeval timeout{0, 300000};
+      setsockopt(client, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+      setsockopt(client, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout));
+      int no_sigpipe = 1;
+      setsockopt(client, SOL_SOCKET, SO_NOSIGPIPE, &no_sigpipe,
+                 sizeof(no_sigpipe));
+      NSDictionary *response = nil;
+      int code = 200;
+      try {
+        std::string request;
+        size_t end = std::string::npos;
+        char buffer[4096];
+        while ((end = request.find("\r\n\r\n")) == std::string::npos) {
+          ssize_t n = recv(client, buffer, sizeof(buffer), 0);
+          if (n <= 0 || request.size() + n > 8192)
+            throw std::runtime_error("invalid HTTP header");
+          request.append(buffer, n);
+        }
+        std::istringstream headers(request.substr(0, end));
+        std::string method, path, version, line;
+        headers >> method >> path >> version;
+        std::getline(headers, line);
+        size_t length = 0;
+        bool found = false;
+        while (std::getline(headers, line)) {
+          std::transform(line.begin(), line.end(), line.begin(),
+                         [](unsigned char c) { return std::tolower(c); });
+          if (line.rfind("transfer-encoding:", 0) == 0)
+            throw std::runtime_error("chunked body unsupported");
+          if (line.rfind("content-length:", 0) == 0) {
+            if (found)
+              throw std::runtime_error("duplicate length");
+            found = true;
+            length = std::stoul(line.substr(15));
+            if (length > 65536)
+              throw std::runtime_error("body too large");
+          }
+        }
+        size_t offset = end + 4;
+        while (request.size() - offset < length) {
+          ssize_t n = recv(
+              client, buffer,
+              std::min(sizeof(buffer), length - (request.size() - offset)), 0);
+          if (n <= 0)
+            throw std::runtime_error("incomplete body");
+          request.append(buffer, n);
+        }
+        NSDictionary *body = nil;
+        if (length) {
+          NSData *d = [NSData dataWithBytes:request.data() + offset
+                                     length:length];
+          body = object([NSJSONSerialization JSONObjectWithData:d
+                                                        options:0
+                                                          error:nil]);
+        }
+        response = handle([NSString stringWithUTF8String:path.c_str()],
+                          [NSString stringWithUTF8String:method.c_str()], body);
+      } catch (const std::exception &e) {
+        code = 409;
+        response = @{
+          @"protocol" : @2,
+          @"error" : @"GATE_NOT_READY",
+          @"reason" : [NSString stringWithUTF8String:e.what()]
+        };
+      }
+      NSData *json = [NSJSONSerialization dataWithJSONObject:response
+                                                     options:0
+                                                       error:nil];
+      std::string header =
+          "HTTP/1.1 " + std::to_string(code) +
+          " OK\r\nContent-Type: application/json\r\nConnection: "
+          "close\r\nContent-Length: " +
+          std::to_string(json.length) + "\r\n\r\n";
+      std::string bytes =
+          header + std::string((const char *)json.bytes, json.length);
+      size_t sent = 0;
+      while (sent < bytes.size()) {
+        ssize_t n = send(client, bytes.data() + sent, bytes.size() - sent, 0);
+        if (n <= 0)
+          break;
+        sent += n;
+      }
+    }
+    close(client);
+  }
+  close(server);
+}
+void start(const char *dir) {
+  if (!getenv("DSTMC_FIRST_PERSON"))
+    return;
+  state().directory = dir;
+  int server = socket(AF_INET, SOCK_STREAM, 0);
+  int reuse = 1;
+  if (server >= 0)
+    setsockopt(server, SOL_SOCKET, SO_REUSEADDR, &reuse, sizeof(reuse));
+  sockaddr_in addr{};
+  addr.sin_family = AF_INET;
+  addr.sin_port = htons(39380);
+  addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  if (server < 0 || bind(server, (sockaddr *)&addr, sizeof(addr)) ||
+      listen(server, 8)) {
+    if (server >= 0)
+      close(server);
+    log(@{
+      @"event" : @"camera_service_failed",
+      @"reason" : @"39380 bind conflict"
+    });
+    return;
+  }
+  state().enabled = true;
+  std::thread(serve, server).detach();
+  log(@{@"event" : @"camera_service_started", @"port" : @39380});
+}
+void report_compose(const dstmc::RenderProbe &camera, dstmc::FrameKey key,
+                    const dstmc::ComposeResult &result) {
+  static uint64_t last = 0;
+  if (milliseconds() - last > 1000) {
+    last = milliseconds();
+    NSMutableArray *matrices = [NSMutableArray array];
+    for (auto &m : camera.shader_matrices)
+      if (m.name == "MatrixV" || m.name == "MatrixP")
+        [matrices addObject:@{
+          @"name" : [NSString stringWithUTF8String:m.name.c_str()],
+          @"value" : matrix(m.value)
+        }];
+    log(@{
+      @"event" : @"compose",
+      @"frame" : @(key.id),
+      @"status" : @(int(result.status)),
+      @"reason" : [NSString stringWithUTF8String:result.reason.c_str()],
+      @"matrices" : matrices,
+      @"width" : @(camera.viewport[2]),
+      @"height" : @(camera.viewport[3])
+    });
+  }
+}
+void present_window(int pw, int ph, bool composited) {
+  if (composited) {
+    std::lock_guard<std::mutex> lock(state().window_mutex);
+    state().last_composite = milliseconds();
+  }
+  // Cocoa view geometry is captured only on the native UI thread. Render pixels
+  // come from the profiled scene.
+  if ([NSThread isMainThread]) {
+    NSWindow *w = [[[NSOpenGLContext currentContext] view] window];
+    NSView *v = w.contentView;
+    if (w && v) {
+      NSRect r = [w convertRectToScreen:[v convertRect:v.bounds toView:nil]];
+      double top = NSMaxY([NSScreen screens][0].frame) - NSMaxY(r);
+      if (pw > 0 && ph > 0) {
+        std::lock_guard<std::mutex> lock(state().window_mutex);
+        [state().window_info release];
+        state().window_info = [@{
+          @"protocol" : @2,
+          @"screen_x" : @(r.origin.x),
+          @"screen_y" : @(top),
+          @"logical_width" : @(r.size.width),
+          @"logical_height" : @(r.size.height),
+          @"physical_width" : @(pw),
+          @"physical_height" : @(ph),
+          @"scale" : @(pw / r.size.width)
+        } retain];
+      }
+    }
+  }
+}
+} // namespace bridge
diff --git a/native/src/camera_service.cpp b/native/src/camera_service.cpp
new file mode 100644
index 0000000..cba7c21
--- /dev/null
+++ b/native/src/camera_service.cpp
@@ -0,0 +1,93 @@
+#include "camera_service.h"
+#include <chrono>
+namespace dstmc {
+bool same_key(const FrameKey &a, const FrameKey &b) {
+  return a.pair_hash == b.pair_hash && a.epoch == b.epoch && a.id == b.id;
+}
+CameraService::CameraService(Clock clock)
+    : clock_(clock ? std::move(clock) : [] {
+        return uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                            std::chrono::steady_clock::now().time_since_epoch())
+                            .count());
+      }) {}
+void CameraService::discard() {
+  frame_.reset();
+  mapping_.reset();
+  acked_ = leased_ = false;
+}
+void CameraService::expire() {
+  if (frame_ && clock_() >= deadline_)
+    discard();
+}
+void CameraService::offer(std::shared_ptr<FrameView> f,
+                          std::shared_ptr<void> mapping) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  expire();
+  if (!f)
+    return;
+  bool session = have_last_ && f->key.pair_hash == last_.pair_hash &&
+                 f->key.epoch == last_.epoch;
+  if (!session)
+    discard();
+  if (session && f->key.id <= last_.id)
+    return;
+  // A leased pose cannot be replaced by a newer image until presentation or
+  // expiry.
+  if (frame_)
+    return;
+  last_ = f->key;
+  have_last_ = true;
+  mapping_ = std::move(mapping);
+  frame_ = std::move(f);
+  deadline_ = clock_() + 250;
+}
+std::optional<FrameLease> CameraService::lease_latest(PairKey pair,
+                                                      Epoch epoch) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  expire();
+  if (!frame_ || frame_->key.pair_hash != pair || frame_->key.epoch != epoch)
+    return {};
+  auto &f = *frame_;
+  auto p = f.pose;
+  const double dx = f.dst_origin.x - f.mc_origin.x,
+               dy = f.dst_origin.y - f.mc_origin.y,
+               dz = f.dst_origin.z - f.mc_origin.z;
+  p.position = {p.position.x + dx, p.position.y + dy, p.position.z + dz};
+  for (int r = 0; r < 4; r++)
+    p.view[12 + r] = float(f.pose.view[12 + r] - f.pose.view[r] * dx -
+                           f.pose.view[4 + r] * dy - f.pose.view[8 + r] * dz);
+  leased_ = true;
+  return FrameLease{f.key, p, f.width, f.height};
+}
+bool CameraService::camera_applied(FrameKey k) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  expire();
+  if (!frame_ || !leased_ || !same_key(frame_->key, k))
+    return false;
+  acked_ = true;
+  return true;
+}
+std::shared_ptr<const FrameView> CameraService::ready(FrameKey k) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  expire();
+  if (!frame_ || !acked_ || !same_key(frame_->key, k))
+    return {};
+  // Returned alias retains both mmap and slot until the render operation
+  // finishes.
+  struct Held {
+    std::shared_ptr<void> mapping;
+    std::shared_ptr<FrameView> frame;
+  };
+  auto h = std::make_shared<Held>(Held{mapping_, frame_});
+  return std::shared_ptr<const FrameView>(h, frame_.get());
+}
+void CameraService::release() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  discard();
+}
+void CameraService::resize(uint32_t w, uint32_t h) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (frame_ && (frame_->width != w || frame_->height != h))
+    discard();
+}
+} // namespace dstmc
diff --git a/native/src/compositor.mm b/native/src/compositor.mm
new file mode 100644
index 0000000..c383b91
--- /dev/null
+++ b/native/src/compositor.mm
@@ -0,0 +1,250 @@
+#include "compositor.h"
+#include <OpenGL/glext.h>
+#include <algorithm>
+#include <stdexcept>
+namespace dstmc {
+namespace {
+// GL2 attrib stacks cover legacy raster state; FBO/program/PBO require explicit
+// restoration.
+struct State {
+  GLint program, fbo, active, pack, unpack, matrix;
+  GLint textures[3];
+  State() {
+    glGetIntegerv(GL_CURRENT_PROGRAM, &program);
+    glGetIntegerv(GL_FRAMEBUFFER_BINDING_EXT, &fbo);
+    glGetIntegerv(GL_ACTIVE_TEXTURE, &active);
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack);
+    glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpack);
+    glGetIntegerv(GL_MATRIX_MODE, &matrix);
+    glPushAttrib(GL_ALL_ATTRIB_BITS);
+    glPushClientAttrib(GL_CLIENT_ALL_ATTRIB_BITS);
+    for (int i = 0; i < 3; i++) {
+      glActiveTexture(GL_TEXTURE0 + i);
+      glGetIntegerv(GL_TEXTURE_BINDING_2D, &textures[i]);
+    }
+    glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+    glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+    glPixelStorei(GL_UNPACK_SKIP_ROWS, 0);
+    glPixelStorei(GL_UNPACK_SKIP_PIXELS, 0);
+    glPixelStorei(GL_UNPACK_SWAP_BYTES, GL_FALSE);
+  }
+  ~State() {
+    for (int i = 0; i < 3; i++) {
+      glActiveTexture(GL_TEXTURE0 + i);
+      glBindTexture(GL_TEXTURE_2D, textures[i]);
+    }
+    glPopClientAttrib();
+    glPopAttrib();
+    glBindFramebufferEXT(GL_FRAMEBUFFER_EXT, fbo);
+    glUseProgram(program);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, pack);
+    glBindBuffer(GL_PIXEL_UNPACK_BUFFER, unpack);
+    glActiveTexture(active);
+    glMatrixMode(matrix);
+  }
+};
+GLuint shader(GLenum type, const char *source) {
+  GLuint s = glCreateShader(type);
+  glShaderSource(s, 1, &source, nullptr);
+  glCompileShader(s);
+  GLint ok;
+  glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+  if (!ok) {
+    glDeleteShader(s);
+    throw std::runtime_error("compositor shader compilation failed");
+  }
+  return s;
+}
+GLuint program(const char *fragment) {
+  const char *vertex = "#version 120\nvarying vec2 uv;void "
+                       "main(){gl_Position=gl_Vertex;uv=gl_Vertex.xy*.5+.5;}";
+  auto v = shader(GL_VERTEX_SHADER, vertex),
+       f = shader(GL_FRAGMENT_SHADER, fragment);
+  GLuint p = glCreateProgram();
+  glAttachShader(p, v);
+  glAttachShader(p, f);
+  glLinkProgram(p);
+  glDeleteShader(v);
+  glDeleteShader(f);
+  GLint ok;
+  glGetProgramiv(p, GL_LINK_STATUS, &ok);
+  if (!ok) {
+    glDeleteProgram(p);
+    throw std::runtime_error("compositor shader link failed");
+  }
+  return p;
+}
+void quad() {
+  glDisable(GL_DEPTH_TEST);
+  glDepthMask(GL_FALSE);
+  glDisable(GL_ALPHA_TEST);
+  glDisable(GL_SCISSOR_TEST);
+  glDisable(GL_STENCIL_TEST);
+  glDisable(GL_CULL_FACE);
+  glDisable(GL_COLOR_LOGIC_OP);
+  glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+  glPolygonMode(GL_FRONT_AND_BACK, GL_FILL);
+  glEnable(GL_BLEND);
+  glBlendEquationSeparate(GL_FUNC_ADD, GL_FUNC_ADD);
+  glBlendFuncSeparate(GL_ONE, GL_ONE_MINUS_SRC_ALPHA, GL_ONE,
+                      GL_ONE_MINUS_SRC_ALPHA);
+  glBegin(GL_QUADS);
+  glVertex2f(-1, -1);
+  glVertex2f(1, -1);
+  glVertex2f(1, 1);
+  glVertex2f(-1, 1);
+  glEnd();
+}
+void upload(GLuint texture, int unit, int w, int h, GLenum internal,
+            GLenum format, GLenum type, const void *pixels) {
+  glActiveTexture(GL_TEXTURE0 + unit);
+  glBindTexture(GL_TEXTURE_2D, texture);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+  glTexImage2D(GL_TEXTURE_2D, 0, internal, w, h, 0, format, type, pixels);
+}
+const char *fragment = R"GLSL(#version 120
+varying vec2 uv;uniform sampler2D mcColor,mcDepth,hostDepth;uniform mat4 inverseMC,inverseHost;
+void main(){vec4 color=texture2D(mcColor,uv);if(color.a<=0.)discard;
+ float md=texture2D(mcDepth,uv).r,hd=texture2D(hostDepth,uv).r;
+ if(md>=1.||md<0.)discard;
+ vec4 m=inverseMC*vec4(uv*2.-1.,md*2.-1.,1.);vec4 h=inverseHost*vec4(uv*2.-1.,hd*2.-1.,1.);
+ if(abs(m.w)<0.000001||abs(h.w)<0.000001)discard;
+ float mz=-m.z/m.w,hz=-h.z/h.w;if(mz<=0.||(hd<1.&&mz>=hz))discard;gl_FragColor=color;}
+)GLSL";
+} // namespace
+bool inverse_matrix(const std::array<float, 16> &a,
+                    std::array<float, 16> &out) {
+  double m[4][8]{};
+  for (int r = 0; r < 4; r++)
+    for (int c = 0; c < 4; c++) {
+      m[r][c] = a[c * 4 + r];
+      m[r][c + 4] = r == c;
+    }
+  for (int c = 0; c < 4; c++) {
+    int pivot = c;
+    for (int r = c + 1; r < 4; r++)
+      if (std::abs(m[r][c]) > std::abs(m[pivot][c]))
+        pivot = r;
+    if (std::abs(m[pivot][c]) < 1e-12)
+      return false;
+    for (int j = 0; j < 8; j++)
+      std::swap(m[c][j], m[pivot][j]);
+    double s = m[c][c];
+    for (double &v : m[c])
+      v /= s;
+    for (int r = 0; r < 4; r++)
+      if (r != c) {
+        s = m[r][c];
+        for (int j = 0; j < 8; j++)
+          m[r][j] -= s * m[c][j];
+      }
+  }
+  for (int r = 0; r < 4; r++)
+    for (int c = 0; c < 4; c++) {
+      out[c * 4 + r] = float(m[r][c + 4]);
+      if (!std::isfinite(out[c * 4 + r]))
+        return false;
+    }
+  return true;
+}
+bool matching_camera(const FrameView &f, const RenderProbe &p) {
+  if (p.viewport != std::array<int, 4>{0, 0, int(f.width), int(f.height)} ||
+      p.depth_range != std::array<double, 2>{0, 1})
+    return false;
+  const std::array<float, 16> *v = nullptr, *projection = nullptr;
+  for (auto &m : p.shader_matrices) {
+    if (m.name == "MatrixV")
+      v = &m.value;
+    if (m.name == "MatrixP")
+      projection = &m.value;
+  }
+  if (!v || !projection)
+    return false;
+  double delta[3] = {f.dst_origin.x - f.mc_origin.x,
+                     f.dst_origin.y - f.mc_origin.y,
+                     f.dst_origin.z - f.mc_origin.z};
+  for (int i = 0; i < 16; i++) {
+    double expected = f.pose.view[i];
+    if (i >= 12)
+      for (int c = 0; c < 3; c++)
+        expected -= f.pose.view[c * 4 + i - 12] * delta[c];
+    if (!std::isfinite((*v)[i]) || std::abs((*v)[i] - expected) > 0.001)
+      return false;
+  }
+  // Near/far differ by engine; all ray-defining projection entries must agree.
+  for (int i = 0; i < 16; i++)
+    if (i != 10 && i != 14)
+      if (!std::isfinite((*projection)[i]) ||
+          std::abs((*projection)[i] - f.pose.projection[i]) > 0.0002)
+        return false;
+  return true;
+}
+ComposeResult Compositor::compose(FrameKey key, const RenderProbe &p,
+                                  GLuint depth) {
+  auto frame = service_.ready(key);
+  if (!frame)
+    return {ComposeStatus::SKIPPED_STALE, "missing ack or expired frame"};
+  if (!matching_camera(*frame, p))
+    return {ComposeStatus::SKIPPED_MISMATCH,
+            "actual view/rays/pixels mismatch"};
+  if (!depth)
+    return {ComposeStatus::DEPTH_UNAVAILABLE,
+            "verified scene depth unavailable"};
+  std::array<float, 16> mc{}, host{};
+  const std::array<float, 16> *projection = nullptr;
+  for (auto &m : p.shader_matrices)
+    if (m.name == "MatrixP")
+      projection = &m.value;
+  if (!projection || !inverse_matrix(frame->pose.projection, mc) ||
+      !inverse_matrix(*projection, host))
+    return {ComposeStatus::SKIPPED_MISMATCH, "singular projection"};
+  State state;
+  if (!program_) {
+    program_ = program(fragment);
+    glGenTextures(3, textures_);
+  }
+  glUseProgram(program_);
+  upload(textures_[0], 0, frame->width, frame->height, GL_RGBA8, GL_RGBA,
+         GL_UNSIGNED_BYTE, frame->color);
+  upload(textures_[1], 1, frame->width, frame->height, GL_LUMINANCE32F_ARB,
+         GL_LUMINANCE, GL_FLOAT, frame->depth);
+  glActiveTexture(GL_TEXTURE2);
+  glBindTexture(GL_TEXTURE_2D, depth);
+  glUniform1i(glGetUniformLocation(program_, "mcColor"), 0);
+  glUniform1i(glGetUniformLocation(program_, "mcDepth"), 1);
+  glUniform1i(glGetUniformLocation(program_, "hostDepth"), 2);
+  glUniformMatrix4fv(glGetUniformLocation(program_, "inverseMC"), 1, GL_FALSE,
+                     mc.data());
+  glUniformMatrix4fv(glGetUniformLocation(program_, "inverseHost"), 1, GL_FALSE,
+                     host.data());
+  quad();
+  return {ComposeStatus::COMPOSITED, "matched complete frame"};
+}
+void Compositor::hud(const FrameView &f) {
+  State state;
+  if (!hud_program_)
+    hud_program_ =
+        program("#version 120\nvarying vec2 uv;uniform sampler2D color;void "
+                "main(){gl_FragColor=texture2D(color,uv);}");
+  if (!textures_[2])
+    glGenTextures(1, &textures_[2]);
+  glUseProgram(hud_program_);
+  upload(textures_[2], 0, f.width, f.height, GL_RGBA8, GL_RGBA,
+         GL_UNSIGNED_BYTE, f.hud);
+  glUniform1i(glGetUniformLocation(hud_program_, "color"), 0);
+  quad();
+}
+Compositor::~Compositor() {
+  if (CGLGetCurrentContext() != owner_)
+    return;
+  if (program_)
+    glDeleteProgram(program_);
+  if (hud_program_)
+    glDeleteProgram(hud_program_);
+  glDeleteTextures(3, textures_);
+}
+} // namespace dstmc
