+Context& ctx() {
+    auto& s = state();
+    auto current = CGLGetCurrentContext();
+    auto it = s.contexts.find(current);
+    if (it == s.contexts.end()) {
+        it = s.contexts.emplace(current, Context{s.next++}).first;
+    }
+    return it->second;
+}
