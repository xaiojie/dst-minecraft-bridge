+struct State {
+    std::mutex mutex;
+    std::map<CGLContextObj, Context> contexts;
+    uint64_t next = 1;
+    std::string directory;
+    unsigned selected = 0;
+    std::vector<uint64_t> checkpoints;
+    bool explicit_checkpoints = false;
+};
+
+State& state() {
+    static auto* s = new State;
+    return *s;
+}
